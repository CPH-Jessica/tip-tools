PORT=8742
HOST=127.0.0.1
# Long random string. Required before import, backup, or keeper tools.
# Do not commit a real value.
ADMIN_TOKEN=
# Optional. When set, the desk asks for this code before showing the board.
# Leave empty only on your own computer.
SITE_ACCESS_CODE=
# Which clock decides "today" for November 2026.
COMMUNITY_TIMEZONE=America/New_York
DB_PATH=data/tracker.sqlite
KEYS_FILE=data/private/last-import-keys.json
# Set to 1 only when you serve the desk over HTTPS.
COOKIE_SECURE=0
